CORENAME=JTDJBOY

# Video: 6 MHz pixel clock, 384 x 272 (57.4 Hz), visible 256 x 224 (MAME rows 16-239)
JTFRAME_PXLCLK=6
JTFRAME_COLORW=5
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224
JTFRAME_BUTTONS=3
JTFRAME_HEADER=8
JTFRAME_CREDITS
# the BEAST MCU (jt8051) runs on clk24: it does not meet timing at 48 MHz
JTFRAME_CLK24

# SDRAM layout (download offsets, after the 8-byte header)
#   000000 main Z80 (256 kB)   040000 sub Z80 (256 kB)   080000 sound Z80 (128 kB)   0A0000 OKI (256 kB)
#   100000 tiles (1 MB, MAME region as is)   200000 sprites (2 MB, MAME region as is)   400000 BEAST MCU (4 kB)
SUB_START=0x040000
SND_START=0x080000
OKI_START=0x0A0000
JTFRAME_BA1_START=0x100000
JTFRAME_BA2_START=0x200000
JTFRAME_PROM_START=0x400000

[mist|sidi]
JTFRAME_SKIP
