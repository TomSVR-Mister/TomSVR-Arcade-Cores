CORENAME=JTOTHUNDER

# 26.686 MHz / 4 = 6.671 MHz pixel clock, 424 x 262 total, 60.06 Hz
JTFRAME_PLL=jtframe_pll6671
JTFRAME_WIDTH=320
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5
JTFRAME_STEREO
JTFRAME_LIGHTGUN
JTFRAME_BUTTONS=2

JTFRAME_BA1_START=0x080000
ADPCMA_START=0x090000
ADPCMB_START=0x110000
JTFRAME_BA2_START=0x200000
SPRMAP_START=0x280000
JTFRAME_BA3_START=0x400000
JTFRAME_PROM_START=0x600000

JTFRAME_CREDITS
# 93C46 EEPROM, saved as NVRAM
JTFRAME_IOCTL_RD=128

[mist|sidi]
JTFRAME_SKIP
