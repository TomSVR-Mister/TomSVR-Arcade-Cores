CORENAME=JTCHQFLAG
JTFRAME_RATE=59.17
JTFRAME_STEREO

# Video configuration
JTFRAME_COLORW=8
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=304
JTFRAME_HEIGHT=224
JTFRAME_VERTICAL
JTFRAME_BUTTONS=3
JTFRAME_CREDITS

# SDRAM layout (download offsets): 052001 program 0 (320 kB), Z80 0x80000, 007232 #1 0x100000,
# 051316 #1 (4 bpp) 0x88000, 007232 #2 0x180000, 051316 #2 (8 bpp) 0x200000, sprites 0x400000.
# The two 051316 ROMs sit in different SDRAM banks: one bank cannot feed both at the pixel rate.
JTFRAME_BA1_START=0x080000
ROZ1_START       =0x088000
PCM1_START       =0x100000
PCM2_START       =0x180000
JTFRAME_BA2_START=0x200000
JTFRAME_BA3_START=0x400000

[mist|sidi]
JTFRAME_SKIP
