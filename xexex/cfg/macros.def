CORENAME=JTXEXEX

# 32 MHz / 4 = 8 MHz pixel clock, 512 x 289 total (54 Hz), 384 x 256 visible
JTFRAME_PXLCLK=8
JTFRAME_WIDTH=384
JTFRAME_HEIGHT=256
JTFRAME_COLORW=8
JTFRAME_BUTTONS=2
JTFRAME_STEREO

# SDRAM layout (download offsets)
# bank 0: 68000 program, 1 MB
# bank 1: Z80 program 128 kB, K054539 samples 3 MB
# bank 2: K056832 tiles 2 MB, K053250 ROM 512 kB
# bank 3: K053246 sprites 4 MB
JTFRAME_BA1_START=0x100000
PCM_START=0x120000
JTFRAME_BA2_START=0x420000
LVC_START=0x620000
JTFRAME_BA3_START=0x6A0000

JTFRAME_CREDITS
# ER5911 EEPROM, saved as NVRAM
JTFRAME_IOCTL_RD=128

[mist|sidi]
JTFRAME_SKIP
