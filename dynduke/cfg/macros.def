CORENAME=JTDYNDUKE
JTFRAME_RATE=59.64

# 6 MHz pixel clock, 384 x 262 total
JTFRAME_PXLCLK=6
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224
JTFRAME_COLORW=4
JTFRAME_BUTTONS=3
JTFRAME_HEADER=4
JTFRAME_CREDITS

# SDRAM layout (download offsets after the 4-byte header): master V30 0, slave V30 0x60000,
# Z80 0x80000, OKI 0xa0000, characters 0xb0000, background 0x100000, foreground 0x300000, sprites 0x400000
SUB_START=0x060000
JTFRAME_BA1_START=0x080000
OKI_START=0x0a0000
CHR_START=0x0b0000
JTFRAME_BA2_START=0x100000
JTFRAME_BA3_START=0x300000
SPR_START=0x400000

[mist|sidi]
JTFRAME_SKIP
