CORENAME=JTGAELCO2
GAMETOP=jtgaelco2_game_sdram

JTFRAME_WIDTH=320
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5
JTFRAME_BUTTONS=3
JTFRAME_HEADER=8
JTFRAME_CREDITS

# 48 MHz game clock, 96 MHz SDRAM (the sprite engine runs at 96 MHz)
JTFRAME_CLK48
JTFRAME_SDRAM96
JTFRAME_STEREO

# SDRAM layout (download offsets, after the 8-byte header): 68000 program 0, graphics + sound 0x100000,
# DS5002FP program (32 kB, BRAM) 0x900000
JTFRAME_BA1_START=0x100000
JTFRAME_PROM_START=0x900000

[mist|sidi]
JTFRAME_SKIP
