CORENAME=JTGAELCO2
GAMETOP=jtgaelco2_game_sdram

# maximum width (Touch and Go 480); narrower games use part of the line buffer
JTFRAME_WIDTH=480
JTFRAME_HEIGHT=240
JTFRAME_COLORW=5
JTFRAME_BUTTONS=3
JTFRAME_HEADER=8
JTFRAME_CREDITS

# 48 MHz game clock, 96 MHz SDRAM (the sprite engine runs at 96 MHz)
JTFRAME_CLK48
JTFRAME_SDRAM96
JTFRAME_STEREO
# Bang!: guns (the MRA's core_mod light gun flag makes JTFRAME draw the crosshair)
JTFRAME_LIGHTGUN
JTFRAME_SDRAM_LARGE

# SDRAM layout (download offsets, after the 8-byte header): 68000 program 0 (bank 0), graphics + sound 0x100000
# (bank 1, 16 MB), fifth graphics plane 0x1100000 (bank 2, 4 MB), DS5002FP program (32 kB, BRAM) 0x1500000
JTFRAME_BA1_START=0x100000
JTFRAME_BA2_START=0x1100000
JTFRAME_PROM_START=0x1500000

[mister]
# Touch and Go: which monitor to show (status bits 14-13)
CORE_OSD=ODE,Screen (Touch and Go),1,2;

[mist|sidi]
JTFRAME_SKIP
