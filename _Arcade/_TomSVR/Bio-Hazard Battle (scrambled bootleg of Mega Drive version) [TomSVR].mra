<!-- Bio-Hazard Battle (scrambled bootleg of Mega Drive version) on TomSVR_mdboot, a personal MiSTer core for the Mega Drive based arcade bootleg boards
     (MAME sega/megadriv_acbl.cpp "biohzdmb"), built on MegaDrive_MiSTer (Nuked-MD by nukeykt, MiSTer port by
     Alexey Melnikov / Sorgelig). The ROM is assembled from your own MAME zips, unmodified.
     Requires TomSVR_mdboot.rbf. -->
<misterromdescription>
    <name>Bio-Hazard Battle (scrambled bootleg of Mega Drive version) [TomSVR]</name>
    <setname>biohzdmb</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1995</year>
    <manufacturer>bootleg / Sega</manufacturer>
    <players>2</players>
    <rbf>TomSVR_mdboot</rbf>
    <joystick>8</joystick>
    <rom index="0" zip="biohzdmb.zip" md5="None">
        <part>02 06 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0xFF0">00</part>
        <part repeat="0x1000">00</part>
        <part repeat="0xE000">00</part>
        <interleave output="16">
            <part name="u15" crc="41a8eae8" length="0x80000" map="01"/>
            <part name="u14" crc="b96cf28c" length="0x80000" map="10"/>
        </interleave>
    </rom>
    <buttons names="A,B,C,Start,Coin" default="A,B,X,Start,Select"/>
</misterromdescription>
