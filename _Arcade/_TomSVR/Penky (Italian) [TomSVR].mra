        <part name="u115" crc="29449fa2"/>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fb,bf">
        <dip name="Time" bits="0,1" ids="0:30,0:40,0:50,1:00"/>
        <dip name="Difficulty" bits="2,3" ids="Very Hard,Hard,Normal,Easy"/>
        <dip name="Fill to Win" bits="4,5" ids="80%,85%,90%,99.9%"/>
        <dip name="Unknown 1-7" bits="6" ids="On,Off"/>
        <dip name="Game Mode" bits="7" ids="Redemption,Normal"/>
        <dip name="Coinage" bits="8,9" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Points per Ticket" bits="10,11" ids="200k,150k,100k,50k"/>
        <dip name="Vs. Matches" bits="12" ids="2,3"/>
        <dip name="Unknown 2-6" bits="13" ids="On,Off"/>
        <dip name="Demo Sounds" bits="14" ids="On,Off"/>
        <dip name="Slide Show (button 1 advances)" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Unused,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
