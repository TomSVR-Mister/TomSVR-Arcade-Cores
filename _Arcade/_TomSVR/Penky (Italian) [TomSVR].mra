<!-- Penky (Italian) on TomSVR_para, a personal MiSTer core for Yun Sung's Paradise-family boards, built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip, unmodified. Requires TomSVR_para.rbf (v2, Oct 2026 or newer). -->
<misterromdescription>
    <name>Penky (Italian) [TomSVR]</name>
    <setname>penkyi</setname>
    <rotation>horizontal</rotation>
    <mameversion>0282</mameversion>
    <year>1996</year>
    <manufacturer>Yun Sung</manufacturer>
    <players>2</players>
    <rbf>TomSVR_para</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="penkyi.zip|penky.zip" md5="None">
        <part> 37 0F 00 00 </part>
        <part name="u128" crc="17c8c97c" length="0x40000"/>
        <part name="u85" crc="452578cd" length="0x40000"/>
        <part repeat="0x80000"> 00</part>
        <part name="u94" crc="d45bac24"/>
        <part repeat="0x30000"> 00</part>
        <part name="u110" crc="c6501e3a"/>
        <part name="u111" crc="de405c6f"/>
        <part name="yunsung.u92" crc="31993a6c"/>
        <part name="yunsung.u93" crc="b570dc0c"/>
