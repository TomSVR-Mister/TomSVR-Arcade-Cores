<!-- New HyperMan (3-in-1 with Cookie &amp; Bibi &amp; HyperMan) (set 2) on TomSVR_semicom, a personal MiSTer core for the SemiCom games on the Snow Bros-style board
     (MAME snowbros.cpp "3in1semia"), built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own
     MAME zip, unmodified. Requires TomSVR_semicom.rbf. -->
<misterromdescription>
    <name>New HyperMan (3-in-1 with Cookie &amp; Bibi &amp; HyperMan) (set 2) [TomSVR]</name>
    <setname>3in1semia</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1998</year>
    <manufacturer>SemiCom / XESS</manufacturer>
    <players>2</players>
    <rbf>TomSVR_semicom</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="3in1semia.zip|3in1semi.zip" md5="None">
        <part>01 F0 00 00</part>
        <interleave output="16">
            <part name="u74.bin" crc="555ae716" map="10"/>
            <part name="u52.bin" crc="388334a8" map="01"/>
        </interleave>
        <part name="u35.bin" crc="e40481da"/>
        <part repeat="0x30000"> 00</part>
        <part name="u14.bin" crc="c83c11be"/>
        <part name="u75.bin" crc="9d705249"/>
        <part name="u76.bin" crc="b65f5d79"/>
        <part name="u77.bin" crc="b9728be9"/>
        <part name="u78.bin" crc="aefad49e"/>
        <part repeat="0x60000"> FF</part>
        <part name="protdata.bin" crc="85deba7c"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fe,80">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Coinage" bits="1,2,3" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/3C,2C/3C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="4,5,6" ids="Level 3,Level 2,Level 1,Level 8,Level 7,Level 6,Level 5,Level 4"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <dip name="Free Play" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
