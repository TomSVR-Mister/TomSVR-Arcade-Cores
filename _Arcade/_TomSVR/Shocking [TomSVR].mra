<!-- Shocking on TomSVR_ys16, a personal MiSTer core for Yun Sung's 16-bit boards (YS-0211 board), built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip, unmodified (tile ROMs are loaded twice, one copy per scroll layer).
     Requires TomSVR_ys16.rbf. -->
<misterromdescription>
    <name>Shocking [TomSVR]</name>
    <setname>shocking</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1997</year>
    <manufacturer>Yun Sung</manufacturer>
    <players>2</players>
    <rbf>TomSVR_ys16</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="shocking.zip" md5="None">
        <part> 00 00 00 00 </part>
        <interleave output="16">
            <part name="yunsun16.u32" crc="c4998c10" map="01"/>
            <part name="yunsun16.u33" crc="8a155521" map="10"/>
        </interleave>
        <part name="yunsun16.131" crc="d0a1bb8c"/>
        <part repeat="0x10000"> FF</part>
        <interleave output="32">
            <part name="yunsun16.u20" crc="124699d0" map="0001"/>
            <part name="yunsun16.u21" crc="4eea29a2" map="0010"/>
            <part name="yunsun16.u22" crc="d6db0388" map="0100"/>
            <part name="yunsun16.u23" crc="1fa33b2e" map="1000"/>
        </interleave>
        <interleave output="64">
            <part name="yunsun16.u67" crc="e30fb2c4" map="00000021"/>
            <part name="yunsun16.u68" crc="7d702538" map="00002100"/>
            <part name="yunsun16.u69" crc="97447fec" map="00210000"/>
            <part name="yunsun16.u70" crc="1b1f7895" map="21000000"/>
        </interleave>
        <part repeat="0x200000"> FF</part>
        <interleave output="64">
            <part name="yunsun16.u67" crc="e30fb2c4" map="00000021"/>
            <part name="yunsun16.u68" crc="7d702538" map="00002100"/>
            <part name="yunsun16.u69" crc="97447fec" map="00210000"/>
            <part name="yunsun16.u70" crc="1b1f7895" map="21000000"/>
        </interleave>
        <part repeat="0x200000"> FF</part>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,bf">
        <dip name="Coinage" bits="0,1,2" ids="Free Play,3C/1C,2C/1C,3C/2C,2C/3C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="8,9,10" ids="Hardest,Harder,Hard,Medium,Easiest,Easier,Easy,Normal"/>
        <dip name="Lives" bits="12,13" ids="5,4,2,3"/>
        <dip name="Demo Sounds" bits="14" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Unused,Unused,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="2"/>
</misterromdescription>
