<!-- Touch and Go (non North America, checksum 056C138F) on TomSVR_gaelco2, a personal MiSTer core for Gaelco 2 boards (MAME gaelco2.cpp "touchgonnab"),
     built on JTFRAME by Jose Tejada (jotego), with the Gaelco 2 video and GAE1 sound from jlrh's gaelco-fpga.
     The ROM is assembled from your own MAME zip, unmodified. Requires TomSVR_gaelco2.rbf. -->
<misterromdescription>
    <name>Touch and Go (non North America, checksum 056C138F) [TomSVR]</name>
    <setname>touchgonnab</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1995</year>
    <manufacturer>Gaelco</manufacturer>
    <players>4</players>
    <rbf>TomSVR_gaelco2</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="touchgonnab.zip|touchgo.zip" md5="None">
        <part>03 20 04 49 30 20 00 00</part>
        <interleave output="16">
            <part name="v_alt_e_56_15-11.ic56" crc="64b83556" map="10"/>
            <part name="v_alt_o_57_15-11.ic57" crc="e9ceb77a" map="01"/>
