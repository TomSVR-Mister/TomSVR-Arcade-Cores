            <part name="tg_ic67.ic67" crc="c0a2ce5b" offset="0x200000" length="0x200000" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="tg_ic66.ic66" crc="52682953" length="0x200000" map="0012"/>
