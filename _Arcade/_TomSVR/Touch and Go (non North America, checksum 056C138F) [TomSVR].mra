        <dip name="Credit configuration" bits="2" ids="2 Credits Start/1 Credit Continue,1 Credit Start/1 Credit Continue"/>
        <dip name="Coin Slot" bits="3" ids="Common,Independent"/>
        <dip name="Monitor Type" bits="4,5" ids="Double monitor  4 players,-,Single monitor  4 players,Single monitor  2 players"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <dip name="Coin A" bits="8,9,10,11" ids="Disabled or Free Play (if Coin B too),4C/5C,4C/3C,4C/1C,3C/4C,3C/2C,3C/1C,2C/5C,2C/3C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Coin B" bits="12,13,14,15" ids="Disabled or Free Play (if Coin A too),4C/5C,4C/3C,4C/1C,3C/4C,3C/2C,3C/1C,2C/5C,2C/3C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
