<!-- Jumping Pop (Nics) on TomSVR_jpop, a personal MiSTer core based on Jotego's JTKIWI (Taito TNZS / Seta X1), built on JTFRAME.
     The ROM is assembled from your own MAME zip, unmodified. Requires TomSVR_jpop.rbf. The game is played with a spinner (dial);
     a mouse or the joystick (dial emulation) also work. -->
<misterromdescription>
    <name>Jumping Pop (Nics, Korean hack of Plump Pop) [TomSVR]</name>
    <setname>jpopnics</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1992</year>
    <manufacturer>Nics</manufacturer>
    <players>2</players>
    <rbf>TomSVR_jpop</rbf>
    <joystick>8</joystick>
    <region>Korea</region>
    <rom index="0" zip="jpopnics.zip" md5="None">
        <part> 00 40 00 00 </part>
        <part name="u96cpu2" crc="649e951c"/>
        <part name="u124cpu1" crc="8453e8e4"/>
        <part repeat="0x20000"> FF</part>
        <interleave output="32">
            <part name="u92gfx" crc="b30caac7" offset="0x0" length="0x10000" map="0001"/>
            <part name="u94gfx" crc="e49f2fdd" offset="0x0" length="0x10000" map="0010"/>
            <part name="u91gfx" crc="18ada5f2" offset="0x0" length="0x10000" map="0100"/>
            <part name="u93gfx" crc="a7791b5b" offset="0x0" length="0x10000" map="1000"/>
        </interleave>
        <part repeat="0x40000"> 00</part>
        <interleave output="32">
            <part name="u92gfx" crc="b30caac7" offset="0x10000" length="0x10000" map="0001"/>
            <part name="u94gfx" crc="e49f2fdd" offset="0x10000" length="0x10000" map="0010"/>
            <part name="u91gfx" crc="18ada5f2" offset="0x10000" length="0x10000" map="0100"/>
            <part name="u93gfx" crc="a7791b5b" offset="0x10000" length="0x10000" map="1000"/>
        </interleave>
        <part repeat="0x40000"> 00</part>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="FF,FF">
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="100k 400k 300k+,100k 300k 200k+,50k 200k 150k+,50k 250k 200k+"/>
        <dip name="Lives" bits="12,13" ids="5,4,2,3"/>
        <dip name="P1/P2 Collision" bits="14" ids="Yes,No"/>
        <dip name="Allow Continue" bits="15" ids="No,Yes"/>
    </switches>
    <buttons names="Button,-,-,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="2"/>
</misterromdescription>
