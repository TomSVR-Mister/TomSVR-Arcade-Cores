<!-- Cookie &amp; Bibi 2 (English, set 3) on TomSVR_semicom, a personal MiSTer core for the SemiCom games on the Snow Bros-style board
     (MAME snowbros.cpp "cookbib2b"), built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own
     MAME zip, unmodified. Requires TomSVR_semicom.rbf. -->
<misterromdescription>
    <name>Cookie &amp; Bibi 2 (English, set 3) [TomSVR]</name>
    <setname>cookbib2b</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1996</year>
    <manufacturer>SemiCom</manufacturer>
    <players>2</players>
    <rbf>TomSVR_semicom</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="cookbib2b.zip|cookbib2.zip" md5="None">
        <part>00 F0 00 00</part>
        <interleave output="16">
            <part name="ui12.020" crc="bdbcd0d1" map="10"/>
            <part name="uh12.020" crc="a44ec1f8" map="01"/>
        </interleave>
        <part name="u1.512" crc="f59f1c9a"/>
        <part repeat="0x30000"> 00</part>
        <part name="uj15.010" crc="5e6f76b8"/>
        <part repeat="0x20000"> FF</part>
        <part name="ua4.040" crc="f458d52e"/>
        <part name="ua6.040" crc="249e89b4"/>
        <part name="ua8.040" crc="caa25138"/>
        <part repeat="0x80000"> FF</part>
        <part name="protdata_alt.bin" crc="bc136ead"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fe,00">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Max Vs Round" bits="1" ids="1,3"/>
        <dip name="Coinage" bits="2,3,4" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/3C,2C/3C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="5,6" ids="Easy,Hardest,Hard,Normal"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
