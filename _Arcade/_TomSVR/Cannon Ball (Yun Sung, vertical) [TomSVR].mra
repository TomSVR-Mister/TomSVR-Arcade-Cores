<!-- Cannon Ball (Yun Sung, vertical) on TomSVR_ys8, a personal MiSTer core for Yun Sung's 8-bit board, built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip, unmodified. Requires TomSVR_ys8.rbf. -->
<misterromdescription>
    <name>Cannon Ball (Yun Sung, vertical) [TomSVR]</name>
    <setname>cannballv</setname>
    <rotation>vertical (ccw)</rotation>
    <mameversion>0264</mameversion>
    <year>1995</year>
    <manufacturer>Yun Sung</manufacturer>
    <players>2</players>
    <rbf>TomSVR_ys8</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="cannballv.zip|cannball.zip" md5="None">
        <part> 03 00 00 00 </part>
        <part name="yunsung1" crc="f7398b0d"/>
        <part name="cannball.08" crc="11403875"/>
        <part repeat="0x40000"> FF</part>
        <interleave output="32">
            <part name="yunsung3" crc="8217abbe" map="0021"/>
            <part name="yunsung2" crc="76de1045" map="2100"/>
        </interleave>
        <part repeat="0x40000"> FF</part>
        <interleave output="64">
            <part name="yunsung7" crc="a5f1a648" map="00000021"/>
            <part name="yunsung6" crc="8baa686e" map="00002100"/>
            <part name="yunsung5" crc="a7f2ce51" map="00210000"/>
            <part name="yunsung4" crc="74bef793" map="21000000"/>
        </interleave>
    </rom>
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ef,ff">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Difficulty" bits="1,2" ids="Easy,Hardest,Hard,Normal"/>
        <dip name="Flip Screen" bits="3" ids="On,Off"/>
        <dip name="Demo Sounds" bits="4" ids="On,Off"/>
        <dip name="Coinage" bits="5,7" ids="4C/1C,3C/1C,2C/3C,2C/1C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Bombs" bits="10,11" ids="4,1,2,3"/>
    </switches>
    <buttons names="Launch,Rotate,Bomb,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="2"/>
</misterromdescription>
