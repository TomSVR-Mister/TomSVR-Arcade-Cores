<!-- Gun Gabacho (Japan, version 2, checksum C6BB) on TomSVR_gaelco2, a personal MiSTer core for Gaelco 2 boards (MAME gaelco2.cpp "bangj"),
     built on JTFRAME by Jose Tejada (jotego), with the Gaelco 2 video and GAE1 sound from jlrh's gaelco-fpga.
     The ROM is assembled from your own MAME zip, unmodified. Requires TomSVR_gaelco2.rbf. -->
<misterromdescription>
    <name>Gun Gabacho (Japan, version 2, checksum C6BB) [TomSVR]</name>
    <setname>bangj</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1999</year>
    <manufacturer>Gaelco / Bit Managers (GM Shoji license)</manufacturer>
    <players>2</players>
    <rbf>TomSVR_gaelco2</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="bangj.zip|bang.zip" md5="None">
        <part>02 18 E4 3A 18 10 00 00</part>
        <interleave output="16">
            <part name="bang-a.ic53" crc="5ee514e9" map="10"/>
            <part name="bang-a.ic55" crc="b90223ab" map="01"/>
        </interleave>
