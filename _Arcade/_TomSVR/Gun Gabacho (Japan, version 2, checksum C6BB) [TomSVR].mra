            <part name="bang-a.ic2" crc="8ea261a7" map="1000"/>
            <part name="bang-a.ic13" crc="d1146b92" map="0100"/>
        </interleave>
        <interleave output="32">
            <part name="bang18.ic18" crc="2056b1ad" map="0010"/>
            <part name="bang11.ic11" crc="2088d15c" map="0001"/>
            <part name="bang3.ic3" crc="d3da5d4f" map="1000"/>
            <part name="bang5.ic5" crc="9bee444c" map="0100"/>
        </interleave>
        <interleave output="32">
            <part name="bang-a.ic16" crc="3b63acfc" map="0010"/>
