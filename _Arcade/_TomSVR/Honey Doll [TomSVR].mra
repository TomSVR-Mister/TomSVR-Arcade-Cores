<!-- Honey Doll on TomSVR_hdoll, a personal MiSTer core for the Barko Honey Doll board (MAME snowbros.cpp "honeydol"),
     built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own MAME zip, unmodified. Requires TomSVR_hdoll.rbf. -->
<misterromdescription>
    <name>Honey Doll [TomSVR]</name>
    <setname>honeydol</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1995</year>
    <manufacturer>Barko Corp.</manufacturer>
    <players>2</players>
    <rbf>TomSVR_hdoll</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="honeydol.zip" md5="None">
        <interleave output="16">
            <part name="d-17.ui12" crc="cac44154" map="10"/>
            <part name="d-16.uh12" crc="cee1a2e3" map="01"/>
        </interleave>
        <part repeat="0x0"> 00</part>
        <part name="d-12.uh15" crc="386f1b63"/>
        <part repeat="0x8000"> 00</part>
        <part name="d-11.u14" crc="f3ee4861"/>
        <part repeat="0x70000"> FF</part>
        <part name="d-13.1" crc="ff6a57fb"/>
        <part repeat="0x80000"> FF</part>
        <interleave output="16">
            <part name="d-14.5" crc="2178996f" map="01"/>
            <part name="d-18.9" crc="0210507a" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-15.6" crc="6629239e" map="01"/>
            <part name="d-19.10" crc="d27375d5" map="10"/>
        </interleave>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ef">
        <dip name="Coinage" bits="0,1" ids="3C/1C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Show Girls" bits="2" ids="Off,On"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Level Select" bits="6" ids="On,Off"/>
        <dip name="Slide Show On Boot-up" bits="7" ids="On,Off"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Harder,Hard,Normal"/>
        <dip name="Timer Speed" bits="10,11" ids="Fastest,Faster,Fast,Normal"/>
        <dip name="Lives" bits="12,13" ids="1,2,3,5"/>
        <dip name="Max Vs Round" bits="15" ids="1,3"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
