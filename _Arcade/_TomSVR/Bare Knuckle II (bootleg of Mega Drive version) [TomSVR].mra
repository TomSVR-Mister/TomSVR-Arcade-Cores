<!-- Bare Knuckle II (bootleg of Mega Drive version) on TomSVR_mdboot, a personal MiSTer core for the Mega Drive based arcade bootleg boards
     (MAME sega/megadriv_acbl.cpp "barek2mb"), built on MegaDrive_MiSTer (Nuked-MD by nukeykt, MiSTer port by
     Alexey Melnikov / Sorgelig). The ROM is assembled from your own MAME zips, unmodified.
     Requires TomSVR_mdboot.rbf. -->
<misterromdescription>
    <name>Bare Knuckle II (bootleg of Mega Drive version) [TomSVR]</name>
    <setname>barek2mb</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1994</year>
    <manufacturer>bootleg / Sega</manufacturer>
    <players>2</players>
    <rbf>TomSVR_mdboot</rbf>
    <joystick>8</joystick>
    <switches default="FF,FF,FF">
        <dip bits="0,3" name="Coinage" ids="-,8C 3C,5C 3C,3C 2C,2C 3C,6C 1C,5C 1C,4C 1C,3C 1C,2C 1C,1C 6C,1C 5C,1C 4C,1C 3C,1C 2C,1C 1C"/>
        <dip bits="4,5" name="Lives" ids="4,3,2,1"/>
        <dip bits="6,7" name="Difficulty" ids="Hardest,Hard,Medium,Easy"/>
    </switches>
    <rom index="0" zip="barek2mb.zip" md5="None">
        <part>06 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0xFF0">00</part>
        <part name="bk_pic16c57rcp.bin" crc="434ad1b7" length="0x1000"/>
        <part repeat="0xE000">00</part>
        <interleave output="16">
            <part name="m2.bin" crc="59ee0905" length="0x80000" map="01"/>
            <part name="m1.bin" crc="1c1fa718" length="0x80000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="m4.bin" crc="d8c61e0d" length="0x80000" map="01"/>
            <part name="m3.bin" crc="6ec5af5d" length="0x80000" map="10"/>
        </interleave>
    </rom>
    <buttons names="A,B,C,Start,Coin" default="A,B,X,Start,Select"/>
</misterromdescription>
