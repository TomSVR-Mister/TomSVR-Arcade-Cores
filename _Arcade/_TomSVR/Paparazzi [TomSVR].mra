<!-- Paparazzi on TomSVR_ys16, a personal MiSTer core for Yun Sung's 16-bit boards (YS-0211 board), built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip, unmodified (tile ROMs are loaded twice, one copy per scroll layer).
     Requires TomSVR_ys16.rbf. -->
<misterromdescription>
    <name>Paparazzi [TomSVR]</name>
    <setname>paprazzi</setname>
    <rotation>vertical (ccw)</rotation>
    <mameversion>0264</mameversion>
    <year>1996</year>
    <manufacturer>Yun Sung</manufacturer>
    <players>2</players>
    <rbf>TomSVR_ys16</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="paprazzi.zip" md5="None">
        <part> 00 00 00 00 </part>
        <interleave output="16">
            <part name="u32.bin" crc="ad5a3fec" map="01"/>
            <part name="u33.bin" crc="91f33abd" map="10"/>
        </interleave>
        <part repeat="0x40000"> FF</part>
        <part name="u131.bin" crc="bcf7aa12"/>
        <part repeat="0x10000"> FF</part>
        <interleave output="32">
            <part name="u20.bin" crc="ccb0ad6b" map="0001"/>
            <part name="u21.bin" crc="125badf0" map="0010"/>
            <part name="u22.bin" crc="436499c7" map="0100"/>
            <part name="u23.bin" crc="358280fe" map="1000"/>
        </interleave>
        <interleave output="64">
            <part name="u67.bin" crc="ea0b9e27" map="00000021"/>
            <part name="u68.bin" crc="6b7ff4dd" map="00002100"/>
            <part name="u69.bin" crc="06749294" map="00210000"/>
            <part name="u70.bin" crc="0adacdf8" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="u71.bin" crc="69178fc4" map="00000021"/>
            <part name="u72.bin" crc="7c3384b9" map="00002100"/>
            <part name="u73.bin" crc="73fbc13e" map="00210000"/>
            <part name="u74.bin" crc="f1afda11" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="u67.bin" crc="ea0b9e27" map="00000021"/>
            <part name="u68.bin" crc="6b7ff4dd" map="00002100"/>
            <part name="u69.bin" crc="06749294" map="00210000"/>
            <part name="u70.bin" crc="0adacdf8" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="u71.bin" crc="69178fc4" map="00000021"/>
            <part name="u72.bin" crc="7c3384b9" map="00002100"/>
            <part name="u73.bin" crc="73fbc13e" map="00210000"/>
            <part name="u74.bin" crc="f1afda11" map="21000000"/>
        </interleave>
    </rom>
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="bf,af">
        <dip name="Coinage" bits="0,1" ids="3C/1C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Language" bits="3" ids="Korean,English"/>
        <dip name="Enemies" bits="4" ids="Type 1,Type 2"/>
        <dip name="Time" bits="6,7" ids="80,100,120,150"/>
        <dip name="Difficulty" bits="8,9,10" ids="Hardest,Harder,Hard,Medium,Easiest,Easier,Easy,Normal"/>
        <dip name="Lives" bits="12,13" ids="5,4,3,2"/>
        <dip name="Demo Sounds" bits="14" ids="On,Off"/>
        <dip name="Gfx Viewer" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Unused,Unused,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="2"/>
</misterromdescription>
