<!-- Hyper Pacman on TomSVR_semicom, a personal MiSTer core for the SemiCom games on the Snow Bros-style board
     (MAME snowbros.cpp "hyperpac"), built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own
     MAME zip, unmodified. Requires TomSVR_semicom.rbf. -->
<misterromdescription>
    <name>Hyper Pacman [TomSVR]</name>
    <setname>hyperpac</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1995</year>
    <manufacturer>SemiCom</manufacturer>
    <players>2</players>
    <rbf>TomSVR_semicom</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="hyperpac.zip" md5="None">
        <part>10 F0 00 00</part>
        <interleave output="16">
            <part name="hyperpac.i12" crc="9c7d85b8" map="10"/>
            <part name="hyperpac.h12" crc="2cf0531a" map="01"/>
        </interleave>
        <part repeat="0x40000"> 00</part>
        <part name="hyperpac.u1" crc="03faf88e"/>
        <part repeat="0x30000"> 00</part>
        <part name="hyperpac.j15" crc="fb9f468d"/>
        <part name="hyperpac.a4" crc="bd8673da"/>
        <part name="hyperpac.a5" crc="5d90cd82"/>
        <part name="hyperpac.a6" crc="61d86e63"/>
        <part repeat="0x140000"> FF</part>
        <part repeat="0x200"> 00</part>
        <part repeat="0x1e00"> 00</part>
        <part name="at89c52.bin" crc="291f9326"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="fe,00">
        <dip name="Demo Sounds" bits="0" ids="On,Off"/>
        <dip name="Lives" bits="1" ids="5,3"/>
        <dip name="Coinage" bits="2,3,4" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/3C,2C/3C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="5,6" ids="Easy,Hardest,Hard,Normal"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
