<!-- Jumping Pop (set 1) on TomSVR_esd, a personal MiSTer core for ESD's 16-bit boards, built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip (merged set, current MAME names), unmodified. Requires TomSVR_esd.rbf. -->
<misterromdescription>
    <name>Jumping Pop (set 1) [TomSVR]</name>
    <setname>jumppop</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>2001</year>
    <manufacturer>ESD</manufacturer>
    <players>2</players>
    <rbf>TomSVR_esd</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="jumppop.zip" md5="None">
        <part> A4 00 00 00 </part>
        <part name="68k_prg.bin" crc="123536b9"/>
        <part name="z80_prg.bin" crc="a88d4424"/>
        <part name="samples.bin" crc="066f30a7"/>
        <part repeat="0x40000"> 00</part>
        <part repeat="0xc0000"> FF</part>
        <interleave output="32">
            <part name="sp0.bin" crc="7c5d0633" map="0021"/>
            <part name="sp1.bin" crc="7eae782e" map="2100"/>
        </interleave>
        <part repeat="0x200000"> 00</part>
        <part repeat="0x200000"> 00</part>
        <interleave output="32">
            <part name="bg1.bin" crc="5b37f943" map="0021"/>
            <part name="bg0.bin" crc="35a1363d" map="2100"/>
        </interleave>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="FF,FE">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Coin B" bits="2,4" ids="3C1C,1C4C,1C6C,1C2C,2C1C,1C3C,1C5C,1C1C"/>
        <dip name="Coin A" bits="5,7" ids="3C1C,1C4C,1C6C,1C2C,2C1C,1C3C,1C5C,1C1C"/>
        <dip name="Demo Sounds" bits="8" ids="On,Off"/>
        <dip name="Allow Continue" bits="9" ids="No,Yes"/>
        <dip name="Picture Viewer" bits="10" ids="On,Off"/>
        <dip name="BG Modesty" bits="11" ids="Less,More"/>
        <dip name="Difficulty" bits="12,13" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Lives" bits="14,15" ids="2,4,1,3"/>
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
