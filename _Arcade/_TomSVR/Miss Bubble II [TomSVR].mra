<!-- Miss Bubble II on TomSVR_missb, a personal MiSTer core based on Jotego's JTBUBL (Bubble Bobble), built on JTFRAME.
     The ROM is assembled from your own MAME zip (merged set), unmodified. Requires TomSVR_missb.rbf. -->
<misterromdescription>
    <name>Miss Bubble II [TomSVR]</name>
    <setname>missb2</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1996</year>
    <manufacturer>Alpha Co.</manufacturer>
    <players>2</players>
    <rbf>TomSVR_missb</rbf>
    <joystick>2-way</joystick>
    <region>World</region>
    <rom index="0" zip="missb2.zip" md5="None">
        <part> 00 00 00 00 </part>
        <part name="msbub2-u.204" crc="b633bdde" length="0x8000"/>
        <part name="msbub2-u.203" crc="29fd8afe"/>
        <part repeat="0x10000"> FF</part>
        <part name="msbub2-u.11" crc="003dc092"/>
        <part repeat="0x8000"> FF</part>
        <part name="msbub2-u.211" crc="08e5d846"/>
        <part name="msbub2-u.13" crc="7a4f4272"/>
        <part repeat="0x98000"> 00</part>
        <interleave output="16">
            <part name="msbub2-u.ic4" crc="be71c9f0" map="01"/>
            <part name="msbub2-u.ic2" crc="694c2783" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="msbub2-u.ic3" crc="90e56035" map="01"/>
            <part name="msbub2-u.ic1" crc="d621cbc3" map="10"/>
        </interleave>
        <interleave output="32">
            <part name="msbub2-u.14" crc="b3164b47" map="0021"/>
            <part name="msbub2-u.126" crc="b0a9a353" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="msbub2-u.124" crc="4b0d8e5b" map="0021"/>
            <part name="msbub2-u.125" crc="77b710e2" map="2100"/>
        </interleave>
        <part name="a71-25.bin" crc="2d0f8545"/>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="FE,3F">
        <dip name="Language" bits="0" ids="English,Japanese"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2C3C,2C1C,1C2C,1C1C"/>
        <dip name="Coin B" bits="6,7" ids="2C3C,2C1C,1C2C,1C1C"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="50K 250K,40K 200K,20K 80K,30K 100K"/>
        <dip name="Lives" bits="12,13" ids="2,1,5,3"/>
        <dip name="Monster Speed" bits="14,15" ids="Normal,Medium,High,Very High"/>
    </switches>
    <buttons names="Jump,Shoot,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
