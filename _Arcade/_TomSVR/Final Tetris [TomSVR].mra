<!-- Final Tetris on TomSVR_semicom, a personal MiSTer core for the SemiCom games on the Snow Bros-style board
     (MAME snowbros.cpp "finalttr"), built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own
     MAME zip, unmodified. Requires TomSVR_semicom.rbf. -->
<misterromdescription>
    <name>Final Tetris [TomSVR]</name>
    <setname>finalttr</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1993</year>
    <manufacturer>Jeil Computer System</manufacturer>
    <players>2</players>
    <rbf>TomSVR_semicom</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="finalttr.zip" md5="None">
        <part>0C F0 00 00</part>
        <interleave output="16">
            <part name="10.7o" crc="eecc83e5" map="10"/>
            <part name="9.5o" crc="58d3640e" map="01"/>
        </interleave>
        <part repeat="0x40000"> 00</part>
        <part name="12.5r" crc="4bc21361"/>
        <part repeat="0x30000"> 00</part>
        <part name="11.7p" crc="2e331022"/>
        <part repeat="0x20000"> FF</part>
        <part name="5.1d" crc="64a450f3"/>
        <part name="6.1f" crc="7281a3cc"/>
        <part name="7.1g" crc="ec80f442"/>
        <part name="9.1h" crc="2ebd316d"/>
        <part repeat="0x100000"> FF</part>
        <part name="protdata.bin" crc="d5bbb006"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <dip name="Demo Sounds" bits="0" ids="Off,On"/>
        <dip name="Unknown" bits="1" ids="On,Off"/>
        <dip name="Unknown" bits="2" ids="On,Off"/>
        <dip name="Coinage" bits="3,4,5" ids="4C/1C,1C/4C,3C/1C,-,2C/3C,1C/2C,2C/1C,1C/1C"/>
        <dip name="Unknown" bits="6" ids="On,Off"/>
        <dip name="Unknown" bits="7" ids="On,Off"/>
        <dip name="Unknown" bits="8" ids="On,Off"/>
        <dip name="Unknown" bits="9" ids="On,Off"/>
        <dip name="Time" bits="10,11" ids="60 Seconds,150 Seconds,120 Seconds,90 Seconds"/>
        <dip name="Unknown" bits="12" ids="On,Off"/>
        <dip name="Unknown" bits="13" ids="On,Off"/>
        <dip name="Unknown" bits="14" ids="On,Off"/>
        <dip name="Unknown" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
