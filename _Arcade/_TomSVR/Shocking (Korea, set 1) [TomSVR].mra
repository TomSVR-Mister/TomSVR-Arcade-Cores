<!-- Shocking (Korea, set 1) on TomSVR_ys16, a personal MiSTer core for Yun Sung's 16-bit boards (YS-0211 board), built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip, unmodified (tile ROMs are loaded twice, one copy per scroll layer).
     Requires TomSVR_ys16.rbf. -->
<misterromdescription>
    <name>Shocking (Korea, set 1) [TomSVR]</name>
    <setname>shockingk</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1997</year>
    <manufacturer>Yun Sung</manufacturer>
    <players>2</players>
    <rbf>TomSVR_ys16</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="shockingk.zip|shocking.zip" md5="None">
        <part> 00 00 00 00 </part>
        <interleave output="16">
            <part name="u32.bin" crc="be2125f4" map="01"/>
            <part name="u33.bin" crc="870108ad" map="10"/>
        </interleave>
        <part name="yunsun16.131" crc="d0a1bb8c"/>
        <part repeat="0x10000"> FF</part>
        <interleave output="32">
            <part name="u20.bin" crc="3502a477" map="0001"/>
            <part name="u21.bin" crc="ffe0af85" map="0010"/>
            <part name="u22.bin" crc="59260de1" map="0100"/>
            <part name="u23.bin" crc="00e4af23" map="1000"/>
        </interleave>
        <interleave output="64">
            <part name="u67.bin" crc="7b0f3944" map="00000021"/>
            <part name="u68.bin" crc="aa736da6" map="00002100"/>
            <part name="u69.bin" crc="292bb626" map="00210000"/>
            <part name="u70.bin" crc="2f9eeb81" map="21000000"/>
        </interleave>
        <part repeat="0x200000"> FF</part>
        <interleave output="64">
            <part name="u67.bin" crc="7b0f3944" map="00000021"/>
            <part name="u68.bin" crc="aa736da6" map="00002100"/>
            <part name="u69.bin" crc="292bb626" map="00210000"/>
            <part name="u70.bin" crc="2f9eeb81" map="21000000"/>
        </interleave>
        <part repeat="0x200000"> FF</part>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,bf">
        <dip name="Coinage" bits="0,1,2" ids="Free Play,3C/1C,2C/1C,3C/2C,2C/3C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="8,9,10" ids="Hardest,Harder,Hard,Medium,Easiest,Easier,Easy,Normal"/>
        <dip name="Lives" bits="12,13" ids="5,4,2,3"/>
        <dip name="Demo Sounds" bits="14" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Unused,Unused,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="2"/>
</misterromdescription>
