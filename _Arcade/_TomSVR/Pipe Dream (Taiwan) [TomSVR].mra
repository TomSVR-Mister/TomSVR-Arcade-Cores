<!-- Pipe Dream (Taiwan) on TomSVR_pipedrm, an unofficial MiSTer core for the Video System Pipe Dream board
     (MAME vsystem/pipedrm.cpp "pipedrmt"), built on JTFRAME by Jose Tejada (jotego), with the sprite chip and GGA
     timing from Andrea Bogazzi's jtpspike. The ROM is assembled from your own MAME zip, unmodified. -->
<misterromdescription>
    <name>Pipe Dream (Taiwan) [TomSVR]</name>
    <setname>pipedrmt</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1990</year>
    <manufacturer>Video System Co.</manufacturer>
    <players>2</players>
    <rbf>TomSVR_pipedrm</rbf>
    <joystick>8</joystick>
    <region>Taiwan</region>
    <rom index="0" zip="pipedrm.zip" md5="None">
        <part> 00 00 00 00 00 00 00 00</part>
        <part name="t1.u129" crc="335401a4"/>
        <part repeat="0x8000"> FF</part>
        <part name="t2.u110" crc="c8209b67"/>
        <part name="u4.u86" crc="497fad4c"/>
        <part repeat="0x8000"> FF</part>
        <part name="u3.u99" crc="4800322a"/>
        <part repeat="0xc0000"> FF</part>
        <part name="s73" crc="63f4e10c"/>
        <part name="s72" crc="4e669e97"/>
        <part name="s71" crc="431485ee"/>
        <part name="s72" crc="4e669e97"/>
        <interleave output="16">
            <part name="a30.u12" crc="50bc5e98" map="01"/>
            <part name="a29.u2" crc="a240a448" map="10"/>
        </interleave>
        <part name="g71.u118" crc="488e2fd1"/>
        <part name="g72.u83" crc="dc3d14be"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <dip name="Coin A" bits="0,3" ids="2C/3C,4C/5C,5C/6C,4C/3C,6C/4C,2C/3C,5C/1C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Coin B" bits="4,7" ids="2C/3C,4C/5C,5C/6C,4C/3C,6C/4C,2C/3C,5C/1C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
