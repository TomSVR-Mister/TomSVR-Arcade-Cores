<!-- TomSVR NSS core (TomSVR_nss). Game PRG ROM, INST ROM and security PROM from MAME nss_ssoc.zip, BIOS from nss.zip, OSD font from m50458.zip, all unmodified. -->
<misterromdescription>
    <name>Super Soccer [TomSVR]</name>
    <setname>nss_ssoc</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1992</year>
    <manufacturer>Human Inc.</manufacturer>
    <players>2</players>
    <rbf>TomSVR_nss</rbf>
    <joystick>8</joystick>
    <switches default="00">
        <dip bits="0" name="Cart DIP 1" ids="Off,On"/>
        <dip bits="1" name="Cart DIP 2" ids="Off,On"/>
        <dip bits="2" name="Cart DIP 3" ids="Off,On"/>
        <dip bits="3" name="Cart DIP 4" ids="Off,On"/>
        <dip bits="4" name="Cart DIP 5" ids="Off,On"/>
        <dip bits="5" name="Cart DIP 6" ids="Off,On"/>
        <dip bits="6" name="Cart DIP 7" ids="Off,On"/>
        <dip bits="7" name="Cart DIP 8" ids="Off,On"/>
    </switches>
    <rom index="0" zip="nss_ssoc.zip|nss.zip" md5="None">
        <part>09 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x1F0">00</part>
        <part name="s-soccer.ic1" crc="70b7f50e"/>
    </rom>
    <rom index="5" zip="nss_ssoc.zip|nss.zip|m50458.zip" md5="None">
        <part name="nss-ic14.02.ic14"/>
        <part name="s-soccer.ic3" crc="c09211c3" offset="0x6000" length="0x2000"/>
        <part name="security.prm" crc="e41c4204"/>
        <part repeat="0x1FF0">FF</part>
        <part name="m50458_char.bin" crc="011cc342"/>
    </rom>
    <nvram index="9" size="256"/>
    <buttons names="A,B,X,Y,L,R,Select,Start,Coin,Instructions,Page Up,Page Down,Game 1,Game 2,Game 3,Service,Restart" default="A,B,X,Y,L,R,R2,Start,Select,L2,-,-,-,-,-,-,-"/>
</misterromdescription>
