<!-- New Splash (ver. 1.4, Korea, set 2) on TomSVR_splash, a personal MiSTer core for Gaelco's Splash! board and Microhard's copy of it, built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip (current MAME naming, merged set), unmodified
     (the graphics ROMs are loaded twice: tilemaps and sprites). Requires TomSVR_splash.rbf. -->
<misterromdescription>
    <name>New Splash (ver. 1.4, Korea, set 2) [TomSVR]</name>
    <setname>nsplashkra</setname>
    <rotation>horizontal</rotation>
    <mameversion>0282</mameversion>
    <year>1992</year>
    <manufacturer>Gaelco / OMK Software</manufacturer>
    <players>2</players>
    <rbf>TomSVR_splash</rbf>
    <joystick>8</joystick>
    <region>Korea</region>
    <rom index="0" zip="splash.zip" md5="None">
        <part> 00 00 00 00 </part>
        <interleave output="16">
            <part name="demo_6_set_1_27c010.bin" crc="8faf055e" map="01"/>
            <part name="demo_2_set_1_27c010.bin" crc="9f2d1cd5" map="10"/>
        </interleave>
        <part repeat="0xc0000"> FF</part>
        <part repeat="0x100000"> FF</part>
        <interleave output="16">
            <part name="new_splash_cor_8_27c040.bin" crc="ccc0d187" map="01"/>
            <part name="new_splash_cor_4_27c040.bin" crc="0f71b5c5" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="new_splash_cor_9_27c040.bin" crc="a50537cc" map="01"/>
            <part name="new_splash_cor_5_27c040.bin" crc="e71f8536" map="10"/>
        </interleave>
        <part repeat="0x10000"> FF</part>
        <part name="splash_1.c5" crc="0ed7ebc9"/>
        <part repeat="0x60000"> FF</part>
        <interleave output="32">
            <part name="new_splash_cor_13_27c010.bin" crc="72ef9811" map="0001"/>
            <part name="new_splash_cor_11_27c010.bin" crc="effa8d57" map="0010"/>
            <part name="new_splash_cor_12_27c010.bin" crc="0f2d8006" map="0100"/>
            <part name="new_splash_cor_10_27c010.bin" crc="cb4bdf04" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="new_splash_cor_13_27c010.bin" crc="72ef9811" map="0001"/>
            <part name="new_splash_cor_11_27c010.bin" crc="effa8d57" map="0010"/>
            <part name="new_splash_cor_12_27c010.bin" crc="0f2d8006" map="0100"/>
            <part name="new_splash_cor_10_27c010.bin" crc="cb4bdf04" map="1000"/>
        </interleave>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <dip name="Coin A" bits="0,3" ids="1C/1C or Free,-,-,-,-,2C/3C,5C/1C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Coin B" bits="4,7" ids="1C/1C or Free,-,-,-,-,2C/3C,5C/1C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Lives" bits="10,11" ids="-,2,1,3"/>
        <dip name="Demo Sounds" bits="12" ids="Off,On"/>
        <dip name="Girls" bits="13" ids="Light,Hard"/>
        <dip name="Paint Mode" bits="14" ids="Paint again,Normal"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Fire 1,Fire 2,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
