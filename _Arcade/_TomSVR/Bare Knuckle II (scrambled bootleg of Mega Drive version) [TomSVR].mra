<!-- Bare Knuckle II (scrambled bootleg of Mega Drive version) on TomSVR_mdboot, a personal MiSTer core for the Mega Drive based arcade bootleg boards
     (MAME sega/megadriv_acbl.cpp "barek2ch"), built on MegaDrive_MiSTer (Nuked-MD by nukeykt, MiSTer port by
     Alexey Melnikov / Sorgelig). The ROM is assembled from your own MAME zips, unmodified.
     Requires TomSVR_mdboot.rbf. -->
<misterromdescription>
    <name>Bare Knuckle II (scrambled bootleg of Mega Drive version) [TomSVR]</name>
    <setname>barek2ch</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1994</year>
    <manufacturer>bootleg</manufacturer>
    <players>2</players>
    <rbf>TomSVR_mdboot</rbf>
    <joystick>8</joystick>
    <switches default="FF,FF,FF">
        <dip bits="0,2" name="Coinage" ids="4C 1C,3C 1C,2C 1C,1C 5C,1C 4C,1C 3C,1C 2C,1C 1C"/>
        <dip bits="11,12" name="Lives" ids="4,3,2,1"/>
        <dip bits="13,15" name="Starting Level" ids="8,7,6,5,4,3,2,1"/>
    </switches>
    <rom index="0" zip="barek2ch.zip" md5="None">
        <part>03 04 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0xFF0">00</part>
        <part repeat="0x1000">00</part>
        <part repeat="0xE000">00</part>
        <interleave output="16">
            <part name="u15" crc="09264195" length="0x80000" map="01"/>
            <part name="u14" crc="b0ee177f" length="0x80000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="u17" crc="cae1922e" length="0x80000" map="01"/>
            <part name="u16" crc="6c814fc4" length="0x80000" map="10"/>
        </interleave>
    </rom>
    <buttons names="A,B,C,Start,Coin" default="A,B,X,Start,Select"/>
</misterromdescription>
