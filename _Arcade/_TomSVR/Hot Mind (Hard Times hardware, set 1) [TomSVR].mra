<!-- Hot Mind (Hard Times hardware, set 1) on TomSVR_playmark, a personal MiSTer core for the Playmark Hard Times board (MAME playmark.cpp "hotmind"),
     built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own MAME zip, unmodified;
     the PIC16C57 sound program is MAME's HEX dump, decoded by the core. Requires TomSVR_playmark.rbf. -->
<misterromdescription>
    <name>Hot Mind (Hard Times hardware, set 1) [TomSVR]</name>
    <setname>hotmind</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1995</year>
    <manufacturer>Playmark</manufacturer>
    <players>2</players>
    <rbf>TomSVR_playmark</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="hotmind.zip" md5="None">
        <part>02 00 00 00</part>
        <interleave output="16">
            <part name="21.u67" crc="e9000f7f" map="10"/>
            <part name="22.u66" crc="2c518ec5" map="01"/>
        </interleave>
        <part repeat="0x2c0000"> FF</part>
        <part name="20.io13" crc="0bf3a3e5"/>
        <part repeat="0xc0000"> FF</part>
        <interleave output="32">
            <part name="26.u86" crc="ff8d3b75" map="0001"/>
            <part name="30.u85" crc="87a640c7" map="0010"/>
            <part name="25.u84" crc="c4fd4445" map="0100"/>
            <part name="29.u83" crc="0bebfb53" map="1000"/>
        </interleave>
        <part repeat="0x180000"> FF</part>
        <interleave output="32">
            <part name="23.u36" crc="ddcf60b9" map="0001"/>
            <part name="27.u42" crc="413bbcf4" map="0010"/>
            <part name="24.u39" crc="4baa5b4c" map="0100"/>
            <part name="28.u45" crc="8df34d6a" map="1000"/>
        </interleave>
        <part repeat="0x180000"> FF</part>
        <part name="hotmind_pic16c57.hex" crc="11957803"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,8f">
        <dip name="Coinage" bits="1,2,3,4" ids="Free Play,8C/3C,5C/3C,3C/2C,2C/3C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,6C/1C,5C/1C,4C/1C,3C/1C,2C/1C,1C/1C"/>
        <dip name="Time Per Line" bits="6" ids="5 Seconds,10 Seconds"/>
        <dip name="Clear All Memory" bits="7" ids="On,Off"/>
        <dip name="Difficulty" bits="8,9,10" ids="Very Hard 5,Very Hard 4,Very Hard 3,Very Hard 2,Very Hard 1,Hard,Normal,Easy"/>
        <dip name="Service Mode" bits="11" ids="On,Off"/>
        <dip name="Demo Sounds" bits="12" ids="On,Off"/>
        <dip name="Token Dispenser" bits="13" ids="On,Off"/>
        <dip name="Ticket Dispenser" bits="14" ids="On,Off"/>
        <dip name="Clear Partial Memory" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Button 2,Unused,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
