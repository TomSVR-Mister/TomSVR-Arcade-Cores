<!-- Hard Times (set 2) on TomSVR_playmark, a personal MiSTer core for the Playmark Hard Times board (MAME playmark.cpp "hrdtimesa"),
     built on JTFRAME by Jose Tejada (jotego). The ROM is assembled from your own MAME zip, unmodified;
     the PIC16C57 sound program is MAME's binary dump, decoded by the core. Requires TomSVR_playmark.rbf. -->
<misterromdescription>
    <name>Hard Times (set 2) [TomSVR]</name>
    <setname>hrdtimesa</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>1994</year>
    <manufacturer>Playmark</manufacturer>
    <players>2</players>
    <rbf>TomSVR_playmark</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="hrdtimes.zip" md5="None">
        <part>06 00 00 00</part>
        <interleave output="16">
            <part name="u67.bin" crc="3e1334cb" map="10"/>
            <part name="u66.bin" crc="041ec30a" map="01"/>
        </interleave>
        <part repeat="0x200000"> FF</part>
        <part name="30.io13" crc="fa5e50ae"/>
        <part repeat="0x80000"> FF</part>
        <interleave output="32">
            <part name="mh1_playmark_ht" crc="927e5989" map="0021"/>
            <part name="mh2_playmark_ht" crc="e76f001b" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="fh1_playmark_ht" crc="3cca02b0" map="0021"/>
            <part name="fh2_playmark_ht" crc="ed699acd" map="2100"/>
        </interleave>
        <part name="pic16c57.bin" crc="db307198"/>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,7f">
        <dip name="Coinage" bits="1,2,3,4" ids="Free Play,8C/3C,5C/3C,3C/2C,2C/3C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,6C/1C,5C/1C,4C/1C,3C/1C,2C/1C,1C/1C"/>
        <dip name="Credits to Start" bits="5" ids="2,1"/>
        <dip name="1 Life If Continue" bits="6" ids="Yes,No"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <dip name="Lives" bits="8,9" ids="1,5,2,3"/>
        <dip name="Bonus Life" bits="10,11" ids="None,Only 500k,Every 500k,Every 300k-500k"/>
        <dip name="Difficulty" bits="12,13" ids="Very Hard,Hard,Easy,Normal"/>
        <dip name="Allow Continue" bits="14" ids="No,Yes"/>
        <dip name="Demo Sounds" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
</misterromdescription>
