<!-- Sonic The Hedgehog (Mega-Tech, set 1) on TomSVR_megatech, a personal MiSTer core for the Sega Mega-Tech (MAME megatech.cpp "mt_sonic"),
     built on MegaDrive_MiSTer (Nuked-MD by nukeykt, MiSTer port by Alexey Melnikov / Sorgelig).
     The ROM is assembled from your own MAME zips, unmodified. Requires TomSVR_megatech.rbf. -->
<misterromdescription>
    <name>Sonic The Hedgehog (Mega-Tech, set 1) [TomSVR]</name>
    <setname>mt_sonic</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1991</year>
    <manufacturer>Sega</manufacturer>
    <players>2</players>
    <rbf>TomSVR_megatech</rbf>
    <joystick>8</joystick>
    <switches default="7F,A1">
        <dip bits="0" name="Coin Slot 4" ids="Inhibit,Accept"/>
        <dip bits="1" name="Coin Slot 3" ids="Inhibit,Accept"/>
        <dip bits="2,4" name="Coin Slot 3/4 Value" ids="1C/10C,1C/8C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="5,7" name="Coin Slot 2 Value" ids="Inhibit,2C/1C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C"/>
        <dip bits="8,11" name="Coin Slot 1 Value" ids="Inhibit,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,1C/7C,1C/8C,1C/9C,1C/10C,1C/11C,1C/12C,1C/13C,1C/14C,1C/15C"/>
        <dip bits="12,15" name="Time Per Credit" ids="Free Play,7:30,7:00,6:30,6:00,5:30,5:00,4:30,4:00,3:30,3:00,2:30,2:00,1:30,1:00,0:30"/>
    </switches>
    <rom index="0" zip="mt_sonic.zip|megatech.zip" md5="None">
        <part name="epr-12664.20" crc="f71e9526"/>
        <part name="epr-12368-52.ic2" crc="6a69d20c"/>
        <part>00 34 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0xFFF0">00</part>
        <interleave output="16">
            <part name="mp13913.ic1" crc="480b4b5c" map="12"/>
        </interleave>
    </rom>
    <nvram index="4" size="8192"/>
    <buttons names="A,B,C,Start,Mode,X,Y,Z,Coin,Select,Enter,Test" default="A,B,X,Start,-,-,-,-,Select,R,L,-"/>
</misterromdescription>
