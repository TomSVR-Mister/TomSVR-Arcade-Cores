<!-- Bare Knuckle III (Conny bootleg of Mega Drive version) on TomSVR_mdboot, a personal MiSTer core for the Mega Drive based arcade bootleg boards
     (MAME sega/megadriv_acbl.cpp "barek3mbc"), built on MegaDrive_MiSTer (Nuked-MD by nukeykt, MiSTer port by
     Alexey Melnikov / Sorgelig). The ROM is assembled from your own MAME zips, unmodified.
     Requires TomSVR_mdboot.rbf. -->
<misterromdescription>
    <name>Bare Knuckle III (Conny bootleg of Mega Drive version) [TomSVR]</name>
    <setname>barek3mbc</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1995</year>
    <manufacturer>bootleg (Conny)</manufacturer>
    <players>2</players>
    <rbf>TomSVR_mdboot</rbf>
    <joystick>8</joystick>
    <rom index="0" zip="barek3mbc.zip" md5="None">
        <part>08 00 82 40 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0xFF0">00</part>
        <part repeat="0x1000">00</part>
        <part repeat="0xE000">00</part>
        <interleave output="16">
            <part name="rom6.bin" crc="a0f9cf5d" length="0x80000" map="01"/>
            <part name="rom3.bin" crc="b6becf5f" length="0x80000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="rom5.bin" crc="d4f52553" length="0x80000" map="01"/>
            <part name="rom2.bin" crc="0c6daeae" length="0x80000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="rom4.bin" crc="4e91f0df" length="0x80000" map="01"/>
            <part name="rom1.bin" crc="ade4166b" length="0x80000" map="10"/>
        </interleave>
    </rom>
    <buttons names="A,B,C,Start,Coin" default="A,B,X,Start,Select"/>
</misterromdescription>
