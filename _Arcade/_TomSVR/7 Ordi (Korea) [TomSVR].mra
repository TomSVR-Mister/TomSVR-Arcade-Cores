<!-- 7 Ordi (Korea) on TomSVR_nmg5, a personal MiSTer core for Yun Sung's YS-1300 board family, built on Jotego's JTFRAME.
     The ROM is assembled from your own MAME zip (merged set), unmodified. Requires TomSVR_nmg5.rbf. -->
<misterromdescription>
    <name>7 Ordi (Korea) [TomSVR]</name>
    <setname>7ordi</setname>
    <rotation>horizontal</rotation>
    <mameversion>0264</mameversion>
    <year>2002</year>
    <manufacturer>Yun Sung</manufacturer>
    <players>2</players>
    <rbf>TomSVR_nmg5</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="7ordi.zip" md5="None">
        <part> C4 20 00 00 </part>
        <interleave output="16">
            <part name="p2.u2" crc="f7943a6a" map="01"/>
            <part name="p1.u7" crc="ebf21862" map="10"/>
        </interleave>
        <part repeat="0xc0000"> FF</part>
        <part name="4.u128" crc="ed73b565"/>
        <part name="3.u137" crc="669ed310"/>
        <part repeat="0x60000"> 00</part>
        <part repeat="0x70000"> FF</part>
        <interleave output="32">
            <part name="4.u83" crc="a2569cf4" map="0001"/>
            <part name="5.u82" crc="045e548e" map="0010"/>
            <part name="3.u105" crc="04c1dbf9" map="0100"/>
            <part name="2.u96" crc="11fa7de8" map="1000"/>
        </interleave>
        <part name="1.u97" crc="cd1ffe88"/>
        <interleave output="64">
            <part name="8.u63" crc="ed8dfe5d" map="00000100"/>
            <part name="11.u68" crc="742764a7" map="00100000"/>
            <part name="9.u73" crc="2b76efd0" map="01000000"/>
            <part name="13.u79" crc="3892b356" map="10000000"/>
            <part name="6.u64" crc="5c0b0838" map="00000001"/>
            <part name="10.u69" crc="c15db1a4" map="00000010"/>
            <part name="7.u74" crc="6910f754" map="00010000"/>
            <part name="12.u80" crc="4c5dd9ef" map="00001000"/>
        </interleave>
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="f3,fb">
        <dip name="High-Low Error" bits="0" ids="Lose All,-500"/>
        <dip name="Minimum Credits" bits="1" ids="500,300"/>
        <dip name="Credit Limit" bits="2,3" ids="100000,50000,30000,10000"/>
        <dip name="Bet" bits="4,5" ids="200 Credits,150 Credits,100 Credits,50 Credits"/>
        <dip name="Coinage" bits="6,7" ids="1 Coin 1000 Credits,1 Coin 500 Credits,1 Coin 100 Credits,1 Coin 50 Credits"/>
        <dip name="Service Mode" bits="8" ids="On,Off"/>
        <dip name="Winnings" bits="10" ids="Credits only,Medals and Credits"/>
        <dip name="Medals Table" bits="11,12" ids="x3.0,x2.0,x1.4,x1.0"/>
        <dip name="Payout %" bits="13,14,15" ids="55%,60%,65%,70%,75%,80%,85%,90%"/>
    </switches>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Button 5,Button 6,Start,Coin,Core credits" default="A,B,X,Y,L,R,Start,Select,-" count="1"/>
</misterromdescription>
