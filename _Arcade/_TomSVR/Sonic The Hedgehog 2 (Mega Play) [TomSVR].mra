<!-- Sonic The Hedgehog 2 (Mega Play) on TomSVR_megaplay, a personal MiSTer core for the Sega Mega Play (MAME megaplay.cpp "mp_soni2"),
     built on MegaDrive_MiSTer (Nuked-MD by nukeykt, MiSTer port by Alexey Melnikov / Sorgelig).
     The ROM is assembled from your own MAME zips, unmodified. Requires TomSVR_megaplay.rbf. -->
<misterromdescription>
    <name>Sonic The Hedgehog 2 (Mega Play) [TomSVR]</name>
    <setname same_dir="1">mp_soni2</setname>
    <rotation>horizontal</rotation>
    <mameversion>0288</mameversion>
    <year>1993</year>
    <manufacturer>Sega</manufacturer>
    <players>2</players>
    <rbf>TomSVR_megaplay</rbf>
    <joystick>8</joystick>
    <switches default="FF,FD">
        <dip bits="0,3" name="Coin Slot 1" ids="Free Play,1C/1C 2C/3C,1C/1C 4C/5C,1C/1C 5C/6C,2C/1C 4C/3C,2C/1C 5C/3C 6C/4C,2C/3C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="4,7" name="Coin Slot 2" ids="1C/1C,1C/1C 2C/3C,1C/1C 4C/5C,1C/1C 5C/6C,2C/1C 4C/3C,2C/1C 5C/3C 6C/4C,2C/3C,4C/1C,3C/1C,2C/1C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="8,9" name="Initial Players (Normal mode)" ids="4,3,2,1"/>
        <dip bits="10,11" name="Initial Players (Dual mode)" ids="4,2,1,3"/>
    </switches>
    <rom index="0" zip="mp_soni2.zip|megaplay.zip" md5="None">
        <part name="ep15294.ic2" crc="aa8dc2d8"/>
        <part name="epr-15175-07.ic1" crc="bb5f67f0"/>
        <part>00 07 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="0x7FF0">00</part>
        <interleave output="16">
            <part name="mpr-16011.ic1" crc="3d7bf98a" map="12"/>
        </interleave>
    </rom>
    <buttons names="A,B,C,Start,Mode,X,Y,Z,Coin,Select,-,Test" default="A,B,X,Start,-,-,-,-,Select,R,-,-"/>
</misterromdescription>
