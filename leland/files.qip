set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/InstructionDefinitions.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/InsnDecoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/microcode/Microcode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/Core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/CSIPSync.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/Divider.sv
