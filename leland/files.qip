set_global_assignment -name QIP_FILE rtl/jt51/hdl/jt51.qip
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/leland_dac_mixer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/leland_sound.sv

set_global_assignment -name SDC_FILE Leland.sdc
