## Leland - MiSTer FPGA Core
## Source file list for Quartus
## Do NOT edit in Quartus IDE — add files here manually.

## ── tv80 Z80 CPU core (submodule: rtl/tv80) ─────────────────────────
## Pure Verilog — compiles cleanly on Quartus 17 Lite (no VHDL parser crash).
## tv80s_ce.v is a local wrapper that exposes the cen clock-enable port.
set_global_assignment -name VERILOG_FILE rtl/tv80/rtl/core/tv80_alu.v
set_global_assignment -name VERILOG_FILE rtl/tv80/rtl/core/tv80_reg.v
set_global_assignment -name VERILOG_FILE rtl/tv80/rtl/core/tv80_mcode.v
set_global_assignment -name VERILOG_FILE rtl/tv80/rtl/core/tv80_core.v
set_global_assignment -name VERILOG_FILE rtl/cpu/tv80s_ce.v

## ── Core RTL ─────────────────────────────────────────────────────────
## leland_board_pkg is imported by the modules below, so it comes first.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/leland_board_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE Leland.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/steering_input.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/trackball_input.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/button_map.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/sdram_banked.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/rom_line_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/leland_vram_port.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/leland_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/leland_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/leland_slave.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/leland_master_ataxx.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/leland_slave_ataxx.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/leland_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/leland_retimer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/leland_ddr_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/leland_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/leland_eeprom_93c46.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/leland_eeprom_93c56.sv


## ── Sound board ─────────────────────────────────────────────────────
## Vendored s80x86 core (rtl/s80x86, GPLv3, see its README_VENDORING.md), i186_periph,
## KF8253 PIT8254 (rtl/KF8253, MIT), leland_sound_board and leland_dac_mixer, bundled
## by rtl/audio/leland_sound.sv. config.v's `define must precede Flags.sv, which reads it
## with no `include, so file order matters.
set_global_assignment -name SEARCH_PATH rtl/KF8253
set_global_assignment -name SEARCH_PATH rtl/s80x86/microcode
set_global_assignment -name VERILOG_FILE rtl/s80x86/config.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/microcode/MicrocodeTypes.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/FlagsEnum.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/aaa.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/aas.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/adc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/add.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/and.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/bound.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/daa.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/das.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/enter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/extend.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/flags.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/mul.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/or.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/not.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/rcl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/rcr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/rol.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/ror.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/sar.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/shift_flags.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/shl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/s80x86/alu/shr.sv
